# ── DEEN Gateway configuration ───────────────────────────────────────
# Copy to .env and fill in. NEVER commit .env (it holds secrets).

# Port the gateway listens on
PORT=8787

# Public base URL the mobile app will call, e.g. https://deen-gateway.onrender.com
# (Leave blank to run in pure seed mode; the app then uses its offline fallback.)
GATEWAY_PUBLIC_URL=

# Optional client key the apps must send as `x-api-key`.
# If set, every request must include it. If blank, the gateway is open.
# NOTE: this is client identification, NOT a secret — the real secret is the
# WooCommerce key below, which lives ONLY on this server.
GATEWAY_API_KEY=

# ── WooCommerce (live store) ──────────────────────────────────────────
# Leave blank to serve the bundled seed catalog. Fill in to go live against
# https://deencommerce.com/ . Generate keys in WP Admin → WooCommerce → Settings → Advanced → REST API.
WOO_SITE=https://deencommerce.com
WOO_CONSUMER_KEY=
WOO_CONSUMER_SECRET=

# ── Pathao Courier API (Live Merchant / Sandbox) ───────────────────────
# Put your Pathao Developer credentials here.
# Production URL: https://hermes-api.pathao.com
# Sandbox URL:    https://courier-api-sandbox.pathao.com
PATHAO_BASE_URL=https://hermes-api.pathao.com
PATHAO_CLIENT_ID=
PATHAO_CLIENT_SECRET=
PATHAO_USERNAME=
PATHAO_PASSWORD=
PATHAO_STORE_ID=

# LOG_LEVEL=info|debug
LOG_LEVEL=info

# WooCommerce webhook verification secret. Set a random value, then POST /v1/deen/webhook/woo/register once.
WEBHOOK_SECRET=

# Public store notice shown as a dismissible banner in the app (leave blank for none).
PUBLIC_NOTICE=

# ── Social sign-in verification (Google / Facebook) ────────────────────
# The gateway verifies provider tokens itself: a token minted for another
# client/app is rejected (401). These must match the apps' OAuth clients.
# Google Cloud Console → APIs & Services → Credentials → OAuth client ID (Web).
GOOGLE_CLIENT_ID=
# Meta for Developers → App → Settings → Basic.
# The app secret NEVER leaves this server (debug_token + appsecret_proof).
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
# LOCAL-DEV ONLY: accept a social sign-in whose provider token is missing or
# unverifiable (identity then comes from the request body). Ignored entirely
# when NODE_ENV=production, so it can never weaken a deployed gateway.
SOCIAL_AUTH_ALLOW_UNVERIFIED=false

# Dedicated HMAC key for signing session tokens. Falls back to
# WEBHOOK_SECRET / GATEWAY_API_KEY, but set a high-entropy value here so the
# webhook secret can be rotated without logging every customer out.
SESSION_SIGNING_SECRET=
