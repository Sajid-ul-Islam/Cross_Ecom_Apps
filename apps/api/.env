# ── DEEN Gateway configuration ───────────────────────────────────────
# Copy to .env and fill in. NEVER commit .env (it holds secrets).

# Port the gateway listens on
PORT=8787

# Public base URL the mobile app will call, e.g. https://deen-gateway.onrender.com
# (Leave blank to run in pure seed mode; the app then uses its offline fallback.)
GATEWAY_PUBLIC_URL=

# Optional client key the apps must send as `x-api-key`.
# If set, every request must include it. If blank, the gateway is open.
# NOTE: this is client identification, NOT a secret — the real secret is the
# WooCommerce key below, which lives ONLY on this server.
GATEWAY_API_KEY=

# ── WooCommerce (live store) ──────────────────────────────────────────
# Leave blank to serve the bundled seed catalog. Fill in to go live against
# https://deencommerce.bd/ . Generate keys in WP Admin → WooCommerce → Settings → Advanced → REST API.
WOO_SITE=https://deencommerce.com
WOO_CONSUMER_KEY=ck_954a53b921ceb29ff572460856193d9b57c94c23
WOO_CONSUMER_SECRET=cs_e3c0de58c7b1a8ff116215f5241c192f4b832e49

# LOG_LEVEL=info|debug
LOG_LEVEL=info



# === TEST ONLY — WordPress account for verifying login flow (do NOT commit) ===
WP_TEST_USER=sazid
WP_TEST_EMAIL=sazid@deencommece.com
WP_TEST_PASSWORD=raIenwkcxImHG0CAGeSASR(
