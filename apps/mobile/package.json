{
  "name": "deen-mobile",
  "version": "1.0.1",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "export:android": "NODE_OPTIONS=\"--require ./scripts/node18-polyfill.cjs\" expo export -p android",
    "build:apk": "eas build -p android --profile production-apk",
    "build:android": "eas build -p android --profile preview",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~56.0.0",
    "expo-constants": "~56.0.24",
    "expo-font": "~56.0.7",
    "expo-linking": "~56.0.17",
    "expo-router": "~56.2.19",
    "expo-status-bar": "~56.0.4",
    "lottie-react-native": "~7.3.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.85.3",
    "react-native-gesture-handler": "~2.31.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4"
  },
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@types/react": "~19.2.8",
    "@types/react-dom": "~19.2.0",
    "babel-preset-expo": "~56.0.0",
    "typescript": "~6.0.3"
  },
  "overrides": {
    "react": "$react",
    "react-dom": "$react-dom"
  },
  "private": true
}
