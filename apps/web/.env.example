# ============================================================
# DEEN Commerce — Web Storefront (.env.example)
# ============================================================

# ------------------------------------------------------------
# 1. WooCommerce REST API v3 (for Chatbot & Order Creation)
# ------------------------------------------------------------
WOO_URL=https://deencommerce.com/wp-json/wc/v3
WOO_KEY=ck_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
WOO_SECRET=cs_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ------------------------------------------------------------
# 2. Fastify API Gateway
# ------------------------------------------------------------
NEXT_PUBLIC_API_URL=https://cross-ecom-apps-4b4n.onrender.com
NEXT_PUBLIC_GATEWAY_API_KEY=fa002b126085801f23d9375d94409752503639919e39690c42877fc58c624973

# ------------------------------------------------------------
# 3. Store Metadata & Branding
# ------------------------------------------------------------
NEXT_PUBLIC_STORE_NAME="DEEN Commerce"
NEXT_PUBLIC_SITE_NAME="DEEN Commerce"
NEXT_PUBLIC_SITE_URL="https://deencommerce.com"

# ------------------------------------------------------------
# 4. Social Authentication (Google & Facebook OAuth)
# ------------------------------------------------------------
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
NEXT_PUBLIC_FACEBOOK_APP_ID=your-facebook-app-id

# ------------------------------------------------------------
# 5. Analytics (Optional)
# ------------------------------------------------------------
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-DEEN2026BD
