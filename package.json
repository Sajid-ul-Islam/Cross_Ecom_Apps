{
  "name": "cross-ecom-apps",
  "private": true,
  "type": "module",
  "description": "DEEN Commerce monorepo — apps/api (Fastify gateway), apps/mobile (Expo), apps/web (Next.js)",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck:api": "cd apps/api && npx tsc --noEmit",
    "typecheck:web": "cd apps/web && npx tsc --noEmit",
    "typecheck:mobile": "cd apps/mobile && npx tsc --noEmit",
    "typecheck:all": "npm run typecheck:api && npm run typecheck:web && npm run typecheck:mobile",
    "typecheck": "npm run typecheck:all"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.1.0",
    "@dnd-kit/sortable": "^8.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@supabase/supabase-js": "^2.98.0",
    "canvas-confetti": "^1.9.3",
    "date-fns": "^2.30.0",
    "framer-motion": "^11.16.1",
    "lucide-react": "^0.294.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.8.0",
    "recharts": "^2.10.0",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.7",
    "@types/canvas-confetti": "^1.6.4",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "tailwindcss": "^4.1.7",
    "typescript": "^5.7.0",
    "vite": "^6.3.5"
  }
}
