{
  "name": "cross-ecom-apps",
  "private": true,
  "type": "module",
  "description": "DEEN Commerce monorepo — apps/mobile (Expo), apps/web (Next.js)",
  "scripts": {
    "build:web": "npm run --prefix apps/web build",
    "build:mobile": "npm run --prefix apps/mobile export:android",
    "build:all": "npm run build:web && npm run build:mobile",
    "build": "npm run build:web",
    "typecheck:web": "npm run --prefix apps/web typecheck",
    "typecheck:mobile": "npm run --prefix apps/mobile typecheck",
    "typecheck:all": "npm run typecheck:web && npm run typecheck:mobile",
    "typecheck": "npm run typecheck:all",
    "test:web": "npm run --prefix apps/web test",
    "test:mobile": "npm run --prefix apps/mobile test",
    "test": "npm run test:web && npm run test:mobile"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.1.0",
    "@dnd-kit/sortable": "^8.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@supabase/supabase-js": "^2.98.0",
    "canvas-confetti": "^1.9.3",
    "date-fns": "^2.30.0",
    "framer-motion": "^11.16.1",
    "lucide-react": "^0.294.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "recharts": "^2.10.0",
    "uuid": "^11.1.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.7",
    "@types/canvas-confetti": "^1.6.4",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "tailwindcss": "^4.1.7",
    "typescript": "^5.7.0",
    "vite": "^6.3.5"
  }
}
