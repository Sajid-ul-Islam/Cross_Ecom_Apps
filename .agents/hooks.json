{
  "safety-gate": {
    "enabled": true,
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"const p = require('fs').existsSync('hooks/safety_guard.cjs') ? './hooks/safety_guard.cjs' : './.agents/hooks/safety_guard.cjs'; require(p);\",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
